---
import agents from '../data/agents.json';
const orbitAgents = [
  ...agents,
  { name: 'Hermes', logo: '/agents/hermes.png', source: 'https://github.com/NousResearch/hermes-agent/blob/main/apps/desktop/public/apple-touch-icon.png' },
  { name: 'Anthropic', logo: '/agents/anthropic.svg', source: 'https://www.anthropic.com/press-kit' }
];
---
<div class="ambient-agents">
  <div class="ambient-ring"></div>
  {orbitAgents.map((agent, index) => <div class={`ambient-agent ambient-agent-${index + 1}`}><span class="agent-tile"><img src={agent.logo} width="32" height="32" alt="" /></span><span class="agent-label">{agent.name}</span></div>)}
</div>
<style>
.ambient-agents { position:absolute; inset:0; pointer-events:none; }
.ambient-ring { position:absolute; inset:8%; border:1px dashed var(--line-strong); border-radius:50%; }
.ambient-ring::after { content:''; position:absolute; inset:15%; border:1px solid var(--line); border-radius:50%; }
.ambient-agent { position:absolute; width:80px; display:flex; flex-direction:column; align-items:center; left:50%; top:50%; animation:hero-agent-orbit 84s linear infinite; }
.agent-tile { display:grid; place-items:center; width:64px; height:64px; background:var(--bg-raised); border:1px solid var(--line); border-radius:20px; box-shadow:0 10px 24px -16px var(--shadow-ink); }
.agent-tile img { width:32px; height:32px; object-fit:contain; }
.agent-label { margin-top:8px; color:var(--ink-muted); font-size:12px; font-weight:500; }
.ambient-agent-2 { animation-delay:-14s; } .ambient-agent-3 { animation-delay:-28s; } .ambient-agent-4 { animation-delay:-42s; } .ambient-agent-5 { animation-delay:-56s; } .ambient-agent-6 { animation-delay:-70s; }
@keyframes hero-agent-orbit { from { transform:translate(-50%,-50%) rotate(0deg) translateX(var(--orbit-radius)) rotate(0deg); } to { transform:translate(-50%,-50%) rotate(360deg) translateX(var(--orbit-radius)) rotate(-360deg); } }
:global(body.page-hidden) .ambient-agent { animation-play-state:paused; }
:global(:root[data-theme="dark"]) .agent-tile img { background:#eef5fb; border-radius:6px; padding:3px; }
@media(prefers-reduced-motion:reduce) { .ambient-agent { animation:none; transform:translate(-50%,-50%) rotate(var(--angle,0deg)) translateX(var(--orbit-radius)) rotate(calc(-1 * var(--angle,0deg))); } .ambient-agent-2 { --angle:60deg; } .ambient-agent-3 { --angle:120deg; } .ambient-agent-4 { --angle:180deg; } .ambient-agent-5 { --angle:240deg; } .ambient-agent-6 { --angle:300deg; } }
</style>
