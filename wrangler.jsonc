{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sinaloa",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "containers": [
    {
      "name": "sinaloa-beta",
      "class_name": "SinaloaContainer",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1,
      "instance_type": "basic",
      "rollout_active_grace_period": 60
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SINALOA_CONTAINER",
        "class_name": "SinaloaContainer"
      }
    ]
  },
  "exports": {
    "SinaloaContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "triggers": {
        "crons": ["* * * * *"]
      },
      "vars": {
        "ENVOI_DEPLOYMENT_ENVIRONMENT": "staging",
        "ENVOI_MALWARE_SCANNER_URL": "https://sinaloa-scanner-staging.rachelgonsalves821.workers.dev/scan"
      },
      "containers": [
        {
          "name": "sinaloa-beta-staging",
          "class_name": "SinaloaContainer",
          "image": "./Dockerfile.cloudflare",
          "max_instances": 1,
          "instance_type": "basic",
          "rollout_active_grace_period": 60
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SINALOA_CONTAINER",
            "class_name": "SinaloaContainer"
          }
        ]
      },
      "exports": {
        "SinaloaContainer": { "type": "durable-object", "storage": "sqlite" }
      }
    },
    "beta": {
      "workers_dev": false,
      "vars": {
        "ENVOI_DEPLOYMENT_ENVIRONMENT": "beta",
        "ENVOI_PUBLIC_URL": "https://www.envoi-agents.com",
        "ENVOI_WAITLIST_SHEET_ID": "1CDA4yMhNErfyx8NFETd2mZg9IjrWBHT2H3_XLqDurac",
        "ENVOI_CORS_ORIGIN": "https://www.envoi-agents.com,https://beta.sinaloa-inbox.com,https://sinaloa-inbox.com,https://www.sinaloa-inbox.com",
        "ENVOI_EDGE_ALLOWED_HOSTS": "www.envoi-agents.com,beta.sinaloa-inbox.com",
        "ENVOI_AGENT_DOMAIN": "envoi-agents.com",
        "ENVOI_DB_SSL_MODE": "verify-full",
        "WORKOS_CLIENT_ID": "client_01M3NESPM075W2JNEB3N7FRVZF",
        "WORKOS_REDIRECT_URI": "https://www.envoi-agents.com/api/auth/workos/callback",
        "ENVOI_POLICY_ACTIVE_KEY_ID": "primary",
        "ENVOI_MONAD_PERMISSIONS": "true",
        "ENVOI_MONAD_ISSUER_ADDRESS": "0xfB83B9008e5A3bA3e6AB63f8C734693e2e120e91",
        "ENVOI_OBJECT_STORAGE_PROVIDER": "s3",
        "ENVOI_S3_ENDPOINT": "https://54a5d6c680bd813fa60f8e088b098b8d.r2.cloudflarestorage.com",
        "ENVOI_S3_BUCKET": "sinaloa-beta",
        "ENVOI_S3_REGION": "auto",
        "ENVOI_MALWARE_SCANNER_URL": "https://sinaloa-scanner-beta.rachelgonsalves821.workers.dev/scan",
        "ENVOI_ENABLE_EXTERNAL_EMAIL": "false",
        "ENVOI_ENABLE_CALENDAR_WRITES": "false",
        "ENVOI_ENABLE_CONSEQUENTIAL_ACTIONS": "false",
        "ENVOI_INSTALLATIONS_V2": "true",
        "ENVOI_AGENT_REGISTRATION_V2": "true",
        "ENVOI_AUTHENTICATED_REST_ROUTE": "false",
        "ENVOI_CASE_SESSIONS_V1": "true",
        "ENVOI_HTTP_WAKE_V1": "true",
        "ENVOI_PROVIDER_BROWSER_POLL": "false",
        "ENVOI_REMOTE_MCP_OAUTH": "true",
        "ENVOI_PROVIDER_CONNECTORS": "false",
        "ENVOI_MCP_WAKE_V1": "false",
        "ENVOI_MCP_EVENTS_V1": "true",
        "ENVOI_GROK_TRIGGER_V1": "false",
        "ENVOI_PROVIDER_GATEWAY_NATIVE_V1": "false",
        "ENVOI_MCP_EVENTS_CALLBACK_ORIGINS": "https://connectors.api.openai.com",
        "ENVOI_GROK_TRIGGER_ORIGINS": "",
        "ENVOI_RELATIONSHIPS_V2": "false",
        "ENVOI_A2A_GATEWAY": "false"
      },
      "routes": [
        {
          "pattern": "www.envoi-agents.com",
          "custom_domain": true
        },
        {
          "pattern": "beta.sinaloa-inbox.com",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      },
      "containers": [
        {
          "name": "sinaloa-beta-release",
          "class_name": "SinaloaContainer",
          "image": "./Dockerfile.cloudflare",
          "max_instances": 1,
          "instance_type": "basic",
          "rollout_active_grace_period": 60
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SINALOA_CONTAINER",
            "class_name": "SinaloaContainer"
          }
        ]
      },
      "exports": {
        "SinaloaContainer": { "type": "durable-object", "storage": "sqlite" }
      }
    }
  }
}
